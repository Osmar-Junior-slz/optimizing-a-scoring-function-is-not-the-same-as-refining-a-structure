# Keep this repository limited to source and execution configuration.
*
!*/
!/.gitignore
!/.gitattributes
!/README.md
!/pyproject.toml
!/requirements-*.txt
!/iniciar_sistema.py
!/iniciar_sistema.cmd
!/src/**/*.py
!/src/dockingpp/configs/default.yaml
!/src/dockingpp/_standalone_manifest.json
!/src/docking_confidence/adapters/factorial_v5.bundle
!/scripts/**/*.py
!/tests/**/*.py
!/configs/*.yaml

# Generated state and external data stay outside version control.
.venv/
venv/
__pycache__/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
/output/
/runs/
/tmp/
/data/
/datasets/
/models/
/artifacts/
/examples/
/docs/
.env
.env.*
.streamlit/secrets.toml
